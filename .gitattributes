# Normalise line endings for source files so Windows and Linux agree.
* text=auto

# Keep experiment evidence and model files byte-for-byte (their SHA-256
# hashes are verified by the frozen protocol) — never convert line endings.
kaggle_training/new_training/** -text
ml/models/** binary
*.pkl binary
*.png binary
*.ico binary
*.ipynb -text

# Upper-estimate artifacts and the parity fixture are hash-checked: keep them byte-for-byte.
ml/upper_estimates_v1/** -text
ml/tests/fixtures/** -text
